<security-config xmlns="http://xmlns.oracle.com/coherence/coherence-security-config" version="1.0">
	<allowed-classes>
		<!-- The events Spring cache stores Event, its ORM-managed participants set and JDBC-loaded date. -->
		<class name="com.oracle.coherence.spring.demo.model.Event" source="manual"/>
		<class name="org.hibernate.collection.spi.PersistentSet" source="manual"/>
		<class name="org.hibernate.collection.spi.AbstractPersistentCollection" source="manual"/>
		<class name="java.sql.Timestamp" source="manual"/>
	</allowed-classes>
</security-config>
